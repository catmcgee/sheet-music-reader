    "@react-native/babel-preset": "0.81.6",
    "@react-native/eslint-config": "0.81.6",
    "@react-native/metro-config": "0.81.6",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.1.4"
  },
  "jest": {
    "preset": "react-native",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-async-storage|@react-navigation|expo(nent)?|@expo(nent)?/.*|expo-.*|react-native-.*)/)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transform": {
      "\\.(ttf|otf)$": "<rootDir>/node_modules/react-native/jest/assetFileTransformer.js",
      "\\.[jt]sx?$": "babel-jest"
    }
  },
  "rnpm": {
    "assets": [
      "./app/fonts"
    ]
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "overrides": {
    "metro": "0.83.8",
    "metro-core": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-config": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-transform-worker": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "postcss": "^8.5.23",
    "fast-xml-parser": "^5.7.0"
